# Soul FastAPI backend environment
# Copy to backend/.env for local development. Configure the same keys as
# Railway service variables for deployment. Never commit real values.

APP_NAME=Soul Backend
ENVIRONMENT=development
PORT=8000

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=voice_agent

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Backend only — do not expose this in Flutter/web builds.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Leave blank to validate sessions through Supabase instead.
SUPABASE_JWT_SECRET=

# CORS: use a JSON list in production, for example:
# CORS_ORIGINS=["https://your-name.github.io"]
CORS_ORIGINS=["*"]

# Build Mode
BUILD_MODE_ENABLED=true
BUILD_STORAGE_ROOT=./drafts
BUILD_DOWNLOAD_SIGNING_SECRET=
# Must exactly match AGENT_BACKEND_SHARED_SECRET on the LiveKit worker.
AGENT_BACKEND_SHARED_SECRET=

# DeepCode provider
DEEPCODE_ENABLED=false
DEEPCODE_BINARY_PATH=deepcode
DEEPCODE_CONNECTION=openrouter
DEEPCODE_PROVIDER_TEMPLATE=openrouter
DEEPCODE_API_KEY_ENV=OPENROUTER_API_KEY
OPENROUTER_API_KEY=
BUILD_RUN_TIMEOUT_SECONDS=600
BUILD_RUN_MAX_OUTPUT_BYTES=2000000
