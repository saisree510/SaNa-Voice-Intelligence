# Copy this file to assets/.env and set your token server sandbox ID,
# found in your LiveKit Cloud project's Settings page.
# Without it, the app connects to a default agent.
LIVEKIT_SANDBOX_ID=<your-sandbox-id>

# Public Supabase settings used for sign-in. Never place service-role, JWT,
# LiveKit API, or agent shared secrets in this mobile/web asset.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supply the backend URL at build time:
# flutter build web --dart-define=SANA_BACKEND_URL=https://your-backend.example
