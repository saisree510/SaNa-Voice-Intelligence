# Flutter client configuration
# Copy to mobile/assets/.env for local development.
# These values are packaged into web/mobile clients: only use public values.

LIVEKIT_SANDBOX_ID=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

