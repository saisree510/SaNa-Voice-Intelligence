# SaNa local development environment template
# Copy to `.env` and fill in values. NEVER commit `.env`.

# --- App ---
SANA_ENV=development
ENVIRONMENT=development
# Emulator -> host machine loopback. Physical device should use your PC LAN IP instead.
SANA_API_BASE_URL=http://10.0.2.2:8000

# --- Supabase (Phase 3+) ---
# Public anon key may be used by Flutter with user auth; service role is BACKEND ONLY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Backend-only JWT verification secret. If omitted, the backend validates
# sessions through SUPABASE_URL + SUPABASE_ANON_KEY.
SUPABASE_JWT_SECRET=

# --- OpenRouter (LLM) ---
# Prefer free models in early development (openrouter/free or :free variants).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Ollama (optional local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# --- LiveKit (Phase 7+) ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# For emulator/device clients, token responses must include a reachable LiveKit URL
# (10.0.2.2 or PC LAN IP), not only 127.0.0.1.

# --- DeepCode / Build Mode (Phase 13+) ---
DEEPCODE_BIN=deepcode
SANA_BUILD_WORKSPACES_ROOT=./workspaces
BUILD_STORAGE_ROOT=./drafts
BUILD_DOWNLOAD_SIGNING_SECRET=
# Shared only by the FastAPI backend and trusted LiveKit worker.
AGENT_BACKEND_SHARED_SECRET=
