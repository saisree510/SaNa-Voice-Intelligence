# Copy this file to .env and fill in real values. Never commit .env.
#
# From your LiveKit Cloud project dashboard (Settings -> Keys):
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Inference bills through your LiveKit project, so no separate
# OpenAI/Deepgram/Cartesia keys are needed for voice OR for the default
# text-chat AI provider (AI_PROVIDER=livekit below).

# FastAPI server port (the token/auth/chat endpoints the app calls).
PORT=8000

# --- Database ---
# Local zero-setup default. For PostgreSQL, see README.md "Database
# setup" — then set this to something like:
#   postgresql+psycopg2://sana:yourpassword@localhost:5432/sana
DATABASE_URL=sqlite:///./sana.db

# --- Auth ---
# REQUIRED. Generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this across environments; never commit the real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- AI provider for text chat (/chat/message) ---
# livekit = reuse the LiveKit credentials above, no new account needed (default)
# mock    = canned responses, no network calls at all (what the test suite uses)
AI_PROVIDER=livekit
AI_MODEL=google/gemma-4-31b-it
