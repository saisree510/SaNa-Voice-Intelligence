# Copy this file to .env and fill in real values. Never commit .env.
#
# From your LiveKit Cloud project dashboard (Settings -> Keys):
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Inference bills through your LiveKit project, so no separate
# OpenAI/Deepgram/Cartesia keys are needed for voice OR for the default
# text-chat AI provider (AI_PROVIDER=livekit below).

# FastAPI server port (the token/auth/chat endpoints the app calls).
PORT=8000

# --- Database ---
# Local zero-setup default. For PostgreSQL, see README.md "Database
# setup" — then set this to something like:
#   postgresql+psycopg2://sana:yourpassword@localhost:5432/sana
DATABASE_URL=sqlite:///./sana.db

# --- Auth ---
# REQUIRED. Generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this across environments; never commit the real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- AI provider for text chat (/chat/message) ---
# livekit = reuse the LiveKit credentials above, no new account needed (default)
# mock    = canned responses, no network calls at all (what the test suite uses)
AI_PROVIDER=livekit
AI_MODEL=google/gemma-4-31b-it

# --- DeepCode (Build mode only — POST /api/build/run) ---
# Full path to your `deepcode` executable. Only "deepcode" (relying on
# PATH) if you're sure it resolves to the right install — if you have
# more than one DeepCode install on this machine, bare "deepcode" may
# resolve to one with no `exec` subcommand ("Unknown option: exec").
# Find yours with `where deepcode` (Windows) / `which -a deepcode`
# (macOS/Linux) and pick the one where `deepcode --help` lists
# `deepcode exec <task>`.
DEEPCODE_BIN=deepcode
# Must match a connection already set up via `deepcode provider list`.
DEEPCODE_CONNECTION=local-ollama
DEEPCODE_MODEL=qwen2.5-coder:7b
# ask | read-only | full-access — full-access matches this project's
# local-trusted-workspace decision; DeepCode's approval prompts are for
# interactive use, not a headless backend call.
DEEPCODE_ACCESS=full-access
DEEPCODE_TRUST=true
# Seconds before a run is killed. Local model inference can be slow —
# leave this generous rather than tight.
DEEPCODE_TIMEOUT_SECONDS=300

# Where generated projects are written — deliberately *not* inside
# sana_app/ or sana_backend/ (DeepCodeService refuses to start if this
# ever resolves inside either). Leave unset to default to sana-builds/
# as a sibling of sana_app/sana_backend; override only if your layout
# differs. Never put a hardcoded personal path here in committed config.
BUILD_WORKSPACES_ROOT=
